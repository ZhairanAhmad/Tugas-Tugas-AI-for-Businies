      "parameters": {
        "jsCode": "let currentSP = $input.item.json['Level Sp'];\nlet nextSP = '';\n\nif (!currentSP || currentSP === '' || currentSP === '-') {\n    nextSP = 'SP1';\n} else if (currentSP === 'SP1') {\n    nextSP = 'SP2';\n} else if (currentSP === 'SP2') {\n    nextSP = 'SP3';\n} else {\n    nextSP = 'SP3 (Maksimal)';\n}\n\nreturn {\n    nama_karyawan: $input.item.json['Nama'],\n    level_sp_baru: nextSP,\n    row_number: $input.item.json['row_number']\n};"
      },
