      "parameters": {
        "jsCode": "// Ambil semua data yang dibutuhkan WF2 dari node-node sebelumnya\nconst nama = $('Membaca Data SP').item.json['Nama'];\nconst email_karyawan = $('On form submission').first().json.Email;\nconst level_sp = $('Code in JavaScript').item.json.level_sp_baru;\nconst jabatan = $('Membaca Data SP').item.json['Jabatan'];\nconst pelanggaran = $('On form submission').item.json['Deskripsi Pelanggaran'];\nconst file_id = $input.first().json.documentId; // ID file PDF yang baru di-upload ke Drive\n\n// ⚠️ GANTI dengan URL n8n kamu!\nconst BASE_URL = 'https://YOUR-N8N-URL.app.n8n.cloud/webhook';\n\nconst konfirmasiUrl = `${BASE_URL}/sp-konfirmasi?nama=${encodeURIComponent(nama)}&email=${encodeURIComponent(email_karyawan)}&level=${encodeURIComponent(level_sp)}&jabatan=${encodeURIComponent(jabatan)}&file_id=${encodeURIComponent(file_id)}`;\n\nreturn {\n  nama_karyawan: nama,\n  email_karyawan: email_karyawan,\n  level_sp: level_sp,\n  jabatan: jabatan,\n  pelanggaran: pelanggaran,\n  file_id: file_id,\n  konfirmasi: konfirmasiUrl\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
