    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>SP Dikonfirmasi</title>\n\n<style>\n*{\n    margin:0;\n    padding:0;\n    box-sizing:border-box;\n    font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n}\n\nbody{\n    min-height:100vh;\n    display:flex;\n    justify-content:center;\n    align-items:center;\n    background:linear-gradient(135deg,#e8f5e9,#f5f7fa);\n}\n\n.container{\n    background:#fff;\n    padding:45px 35px;\n    border-radius:20px;\n    max-width:500px;\n    width:90%;\n    text-align:center;\n    box-shadow:0 15px 40px rgba(0,0,0,0.08);\n    animation:fadeIn .5s ease;\n}\n\n.icon{\n    width:90px;\n    height:90px;\n    margin:0 auto 20px;\n    border-radius:50%;\n    background:#eafaf1;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    font-size:45px;\n}\n\nh1{\n    color:#27ae60;\n    margin-bottom:15px;\n    font-size:30px;\n}\n\np{\n    color:#666;\n    line-height:1.7;\n    margin-bottom:30px;\n}\n\n.btn{\n    display:inline-block;\n    padding:12px 28px;\n    background:#27ae60;\n    color:white;\n    text-decoration:none;\n    border-radius:10px;\n    font-weight:600;\n    transition:.3s;\n}\n\n.btn:hover{\n    background:#219150;\n    transform:translateY(-2px);\n}\n\n@keyframes fadeIn{\n    from{\n        opacity:0;\n        transform:translateY(20px);\n    }\n    to{\n        opacity:1;\n        transform:translateY(0);\n    }\n}\n</style>\n</head>\n<body>\n\n<div class=\"container\">\n    <div class=\"icon\">✅</div>\n\n    <h1>SP Berhasil Dikonfirmasi</h1>\n\n    <p>\n        Surat Peringatan telah berhasil dikonfirmasi oleh atasan dan\n        akan segera dikirimkan kepada karyawan yang bersangkutan.\n    </p>\n\n    <a href=\"https://mail.google.com/mail/u/0/?hl=en#inbox\" class=\"btn\">\n        Kembali ke Dashboard\n    </a>\n</div>\n\n</body>\n</html>",
        "options": {
