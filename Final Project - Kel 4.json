    },
    {
      "parameters": {
        "sendTo": "ilha23077si@student.nurulfikri.ac.id",
        "subject": "=[ACTION REQUIRED] Review {{ $json.level_sp }} - {{ $json.nama_karyawan }}",
        "message": "==<!DOCTYPE html>\n<html>\n<body style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:20px;\">\n\n  <!-- HEADER -->\n  <div style=\"background:#1a1a2e;padding:24px;border-radius:8px 8px 0 0;\">\n    <h2 style=\"color:#fff;margin:0;\">📋 Konfirmasi Surat Peringatan Karyawan</h2>\n    <p style=\"color:#aaa;margin:6px 0 0;\">PT MBG - Departemen Sumber Daya Manusia</p>\n  </div>\n\n  <!-- BODY -->\n  <div style=\"border:1px solid #ddd;border-top:none;padding:24px;border-radius:0 0 8px 8px;background:#fff;\">\n    \n    <p style=\"margin-top:0;\">Yth. HR Manager,</p>\n    <p>\n      Sistem telah membuat <strong>{{ $json.level_sp }}</strong> untuk karyawan berikut. \n      Mohon review dokumen dan klik tombol <strong>Konfirmasi</strong> apabila surat sudah sesuai.\n    </p>\n\n    <!-- TABEL DATA KARYAWAN -->\n    <table style=\"width:100%;border-collapse:collapse;margin:20px 0;font-size:14px;\">\n      <tr style=\"background:#f5f5f5;\">\n        <td style=\"padding:12px;font-weight:bold;width:40%;border:1px solid #eee;\">Nama Karyawan</td>\n        <td style=\"padding:12px;border:1px solid #eee;\">{{ $json.nama_karyawan }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding:12px;font-weight:bold;border:1px solid #eee;\">Jabatan</td>\n        <td style=\"padding:12px;border:1px solid #eee;\">{{ $json.jabatan }}</td>\n      </tr>\n      <tr style=\"background:#f5f5f5;\">\n        <td style=\"padding:12px;font-weight:bold;border:1px solid #eee;\">Level SP</td>\n        <td style=\"padding:12px;border:1px solid #eee;\">\n          <strong style=\"color:#e74c3c;\">{{ $json.level_sp }}</strong>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding:12px;font-weight:bold;border:1px solid #eee;\">Deskripsi Pelanggaran</td>\n        <td style=\"padding:12px;border:1px solid #eee;\">{{ $json.pelanggaran }}</td>\n      </tr>\n    </table>\n\n    <!-- TOMBOL KONFIRMASI -->\n    <div style=\"text-align:center;margin:32px 0;\">\n      <a \n        href=\"https://n8n-7xtcninax5er.jkt1.sumopod.my.id/webhook-test/sp-konfirmasi?status=konfirmasi&nama={{$json.nama_karyawan}}&email={{$json.email_karyawan}}&level_sp={{$json.level_sp}}&jabatan={{$json.jabatan}}&file_id={{ $('Mengisi File Docs Yang Kosong').item.json.documentId }}\" \n        style=\"\n          background:#1a1a2e;\n          color:#fff;\n          padding:16px 48px;\n          border-radius:8px;\n          text-decoration:none;\n          font-size:16px;\n          font-weight:bold;\n          letter-spacing:1px;\n        \"\n      >\n        ✅ KONFIRMASI SP\n      </a>\n    </div>\n\n    <p style=\"color:#555;font-size:13px;\">\n      Dengan mengklik tombol di atas, Anda menyetujui bahwa isi Surat Peringatan \n      telah sesuai dan sistem akan otomatis mengirimkannya ke email karyawan bersangkutan.\n    </p>\n\n    <!-- FOOTER -->\n    <hr style=\"border:none;border-top:1px solid #eee;margin:24px 0;\">\n    <p style=\"color:#aaa;font-size:11px;text-align:center;margin:0;\">\n      Email ini dikirim otomatis oleh Sistem HR PT MBG. Jangan balas email ini.\n    </p>\n\n  </div>\n\n</body>\n</html>",
        "options": {
          "appendAttribution": false
        }
